[Unit]
Description=KidSphere MVP nightly backup (database dump + uploads archive)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
# deploy/backup.sh, installed by deploy/install.sh (and refreshed by deploy/deploy.sh).
ExecStart=/usr/local/sbin/kidsphere-mvp-backup
User=root
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
