# KidSphere API settings (read by pydantic-settings from backend/.env and by
# systemd via EnvironmentFile). Bash never sources this file.
# deploy/install.sh copies it to backend/.env and rewrites DATABASE_URL with a
# generated password for the kidsphere_mvp role.
DATABASE_URL=postgresql+psycopg://kidsphere_mvp:CHANGE_ME@127.0.0.1:5432/kidsphere_mvp
COOKIE_SECURE=true
SESSION_DAYS=7
UPLOAD_DIR=/var/www/kidsphere/uploads
DEFAULT_LOCALE=ar
# Empty key = deterministic template provider (no external AI calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=60
VIDEO_PROVIDER=none
# AI engines (docs/ai-engines.md): each engine is configured with AI_<ENGINE>_* variables
# (provider, model, endpoint, credentials reference, ...). None is set by default: every
# engine reports ENGINE_NOT_CONFIGURED. AI_MOCK_MODE=true runs unconfigured engines on the
# built-in mock provider (development and tests only, never in production).
AI_MOCK_MODE=false
# Lets FastAPI serve a built SPA itself; never set in production (nginx serves the SPA).
SERVE_STATIC_DIR=
LOG_LEVEL=info
# Optional override of the shared vocabulary file (default: app/data/options.json)
# OPTIONS_PATH=
