# KidSphere API settings (read by pydantic-settings from backend/.env and by
# systemd via EnvironmentFile). Bash never sources this file.
DATABASE_URL=postgresql+psycopg://kidsphere:CHANGE_ME@127.0.0.1:5432/kidsphere
APP_URL=https://kids.kortexd.com
COOKIE_SECURE=true
SESSION_DAYS=7
UPLOAD_DIR=/var/www/kidsphere/uploads
DEFAULT_LOCALE=ar
# Empty key = deterministic template provider (no external AI calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=60
VIDEO_PROVIDER=none
# Only for the CI preview; never set in production (nginx serves the SPA).
SERVE_STATIC_DIR=
LOG_LEVEL=info
# Optional override of the shared vocabulary file (default: app/data/options.json)
# OPTIONS_PATH=
