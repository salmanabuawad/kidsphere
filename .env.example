# ── Database ───────────────────────────────────────────────
# Local dev: `npm run db:start` runs PostgreSQL on port 5433 (no Docker needed).
DATABASE_URL=postgresql://kidsphere:kidsphere@localhost:5433/ks_app
# Used by integration tests (wiped on every test run).
TEST_DATABASE_URL=postgresql://kidsphere:kidsphere@localhost:5433/ks_test

# ── Auth ───────────────────────────────────────────────────
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-dev-only-secret-change-me-dev-only
APP_URL=http://localhost:3000
# Set to "true" behind HTTPS so cookies are Secure.
COOKIE_SECURE=false

# ── AI providers (optional — the DEMO provider is used when no key is set) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# anthropic | openai | demo   (empty = first provider with a key, else demo)
AI_DEFAULT_PROVIDER=
AI_TIMEOUT_MS=60000
# The demo provider is refused when NODE_ENV=production unless this is "true".
ALLOW_DEMO_AI_IN_PRODUCTION=false

# ── Storage ────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── i18n ───────────────────────────────────────────────────
DEFAULT_LOCALE=ar
